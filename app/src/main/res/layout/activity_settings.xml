<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/card"
        app:navigationIcon="@android:drawable/ic_menu_revert"
        app:title="@string/settings_title"
        app:titleTextColor="@color/text" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/home_look"
                android:textColor="@color/text"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/theme_mode"
                android:textColor="@color/text" />

            <RadioGroup
                android:id="@+id/rgNight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <RadioButton
                    android:id="@+id/rbNightSystem"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/theme_system"
                    android:textColor="@color/text" />

                <RadioButton
                    android:id="@+id/rbNightLight"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/theme_light"
                    android:textColor="@color/text" />

                <RadioButton
                    android:id="@+id/rbNightDark"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/theme_dark"
                    android:textColor="@color/text" />
            </RadioGroup>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/accent_color"
                android:textColor="@color/text" />

            <LinearLayout
                android:id="@+id/rowAccents"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCustomAccent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/custom_color" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/card_style"
                android:textColor="@color/text" />

            <RadioGroup
                android:id="@+id/rgCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <RadioButton
                    android:id="@+id/rbCardFlat"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/card_flat"
                    android:textColor="@color/text" />

                <RadioButton
                    android:id="@+id/rbCardRounded"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/card_rounded"
                    android:textColor="@color/text" />

                <RadioButton
                    android:id="@+id/rbCardCompact"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/card_compact"
                    android:textColor="@color/text" />
            </RadioGroup>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/sort_order"
                android:textColor="@color/text" />

            <RadioGroup
                android:id="@+id/rgSort"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <RadioButton
                    android:id="@+id/rbSortTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/sort_title"
                    android:textColor="@color/text" />

                <RadioButton
                    android:id="@+id/rbSortArtist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/sort_artist"
                    android:textColor="@color/text" />

                <RadioButton
                    android:id="@+id/rbSortDate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/sort_date"
                    android:textColor="@color/text" />

                <RadioButton
                    android:id="@+id/rbSortDuration"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/sort_duration"
                    android:textColor="@color/text" />
            </RadioGroup>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/grid_span"
                android:textColor="@color/text" />

            <RadioGroup
                android:id="@+id/rgSpan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rbSpan2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2"
                    android:textColor="@color/text" />

                <RadioButton
                    android:id="@+id/rbSpan3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="3"
                    android:textColor="@color/text" />
            </RadioGroup>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/app_font"
                android:textColor="@color/text" />

            <RadioGroup
                android:id="@+id/rgAppFont"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <RadioButton
                    android:id="@+id/rbAppSans"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/font_sans"
                    android:textColor="@color/text" />

                <RadioButton
                    android:id="@+id/rbAppLight"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/font_light"
                    android:textColor="@color/text" />

                <RadioButton
                    android:id="@+id/rbAppSerif"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/font_serif"
                    android:textColor="@color/text" />

                <RadioButton
                    android:id="@+id/rbAppMono"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/font_mono"
                    android:textColor="@color/text" />

                <RadioButton
                    android:id="@+id/rbAppBlack"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/font_black"
                    android:textColor="@color/text" />
            </RadioGroup>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="20dp"
                android:background="@color/muted" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/overlay_section"
                android:textColor="@color/text"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/font_size"
                android:textColor="@color/text"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSizeValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/muted" />

            <SeekBar
                android:id="@+id/seekSize"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/font_style"
                android:textColor="@color/text"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rgFont"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp">

                <RadioButton
                    android:id="@+id/rbSans"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/font_sans"
                    android:textColor="@color/text" />

                <RadioButton
                    android:id="@+id/rbLight"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/font_light"
                    android:textColor="@color/text" />

                <RadioButton
                    android:id="@+id/rbSerif"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/font_serif"
                    android:textColor="@color/text" />

                <RadioButton
                    android:id="@+id/rbMono"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/font_mono"
                    android:textColor="@color/text" />

                <RadioButton
                    android:id="@+id/rbCondensed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/font_condensed"
                    android:textColor="@color/text" />
            </RadioGroup>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/text_color"
                android:textColor="@color/text"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp"
                android:orientation="horizontal">

                <View
                    android:id="@+id/colorWhite"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="8dp"
                    android:background="#FFFFFF" />

                <View
                    android:id="@+id/colorPink"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="8dp"
                    android:background="#FF8A80" />

                <View
                    android:id="@+id/colorPurple"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="8dp"
                    android:background="#EA80FC" />

                <View
                    android:id="@+id/colorBlue"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="8dp"
                    android:background="#8C9EFF" />

                <View
                    android:id="@+id/colorCyan"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="8dp"
                    android:background="#84FFFF" />

                <View
                    android:id="@+id/colorGold"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="#FFF59D" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/anim_style"
                android:textColor="@color/text"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rgAnim"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp">

                <RadioButton
                    android:id="@+id/rbFade"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/anim_fade"
                    android:textColor="@color/text" />

                <RadioButton
                    android:id="@+id/rbScale"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/anim_scale"
                    android:textColor="@color/text" />

                <RadioButton
                    android:id="@+id/rbSlide"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/anim_slide"
                    android:textColor="@color/text" />
            </RadioGroup>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnResetPos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/reset_position" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
